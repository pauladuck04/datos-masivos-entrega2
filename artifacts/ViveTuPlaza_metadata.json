			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"cancelarInscripcion(uint256)": {
					"notice": "Cancela la plaza o el puesto en la lista de espera de quien llama.         Si libera una plaza dentro del plazo de inscripción, la ocupa         automáticamente la primera persona válida de la lista de espera."
				},
				"inscripciones(uint256,address)": {
					"notice": "actividadId => participante => estado de su inscripción"
				},
				"registrarParticipante(address,bytes32)": {
					"notice": "Alta de una persona mayor. Fuera de la cadena (el \"oráculo\" del padrón,         simulado aquí por el administrador) se ha comprobado que cumple los requisitos."
				}
			},
			"notice": "Roles + creación de actividades + inscripción con plazas limitadas         y lista de espera por orden de llegada.",
			"version": 1
		}
